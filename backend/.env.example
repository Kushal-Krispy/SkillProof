# SkillProof Backend Configuration
PROJECT_NAME="SkillProof API"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with asyncpg driver for async SQLAlchemy)
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://skillproof:skillproof_secret@localhost:5432/skillproof_db"

# Sync database URL for Alembic migrations
DATABASE_URL_SYNC="postgresql+psycopg2://skillproof:skillproof_secret@localhost:5432/skillproof_db"

# Testing Database URL (In-memory SQLite async engine or PostgreSQL test instance)
TEST_DATABASE_URL="sqlite+aiosqlite:///:memory:"

# Security & JWT Tokens
# Generate a cryptographically secure key for local development:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Or:
#   openssl rand -hex 32
SECRET_KEY="skillproof-insecure-development-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Session Cookies (HttpOnly, SameSite, Secure)
COOKIE_NAME="access_token"
COOKIE_SECURE=false      # Set to 'true' in production (requires HTTPS)
COOKIE_SAMESITE="lax"   # Lax prevents CSRF on top-level navigation while supporting modern browser flows
COOKIE_PATH="/"

# Login Rate Limiting (Sliding Window)
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
